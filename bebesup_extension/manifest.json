{
  "manifest_version": 3,
  "name": "베베숲 스마트스토어 리뷰 자동 답글 도우미",
  "version": "2.7.2",
  "description": "네이버 스마트스토어 센터에서 1~2점 및 불만글은 자동 제외하고, 3~5점 칭찬 리뷰만 50개씩 공식 문구로 1클릭 일괄 답글을 지원하는 확장 프로그램입니다. (GitHub 핫패치 지원)",
  "content_scripts": [
    {
      "matches": ["https://sell.smartstore.naver.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content_core.js"],
      "matches": ["https://sell.smartstore.naver.com/*"]
    }
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://cdn.jsdelivr.net/*"
  ]
}
